import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';

const AthairApp = () => {
  const [isActive, setIsActive] = useState(false);
  const [isFinished, setIsFinished] = useState(false);
  const [seconds, setSeconds] = useState(300); // 5 minutos
  const [phase, setPhase] = useState('inhale'); // inhale, exhale

  // 1. Temporizador de 5 minutos
  useEffect(() => {
    let interval = null;
    if (isActive && seconds > 0) {
      interval = setInterval(() => setSeconds(s => s - 1), 1000);
    } else if (seconds === 0) {
      setIsActive(false);
      setIsFinished(true);
      // Aquí se activaría la melodía tipo Enya
    }
    return () => clearInterval(interval);
  }, [isActive, seconds]);

  // 2. Ritmo de Nestor (5.5 segundos)
  useEffect(() => {
    if (isActive) {
      const rhythm = setInterval(() => {
        setPhase(prev => (prev === 'inhale' ? 'exhale' : 'inhale'));
      }, 5500);
      return () => clearInterval(rhythm);
    }
  }, [isActive]);

  return (
    <motion.div 
      // Cambio lento de color de fondo (Azul claro a Verde claro)
      animate={{ backgroundColor: phase === 'inhale' ? '#f0f9ff' : '#f0fdf4' }}
      transition={{ duration: 5.5, ease: "linear" }}
      className="h-screen w-full flex flex-col items-center justify-between p-10 text-stone-600 font-light"
    >
      {/* Barra de progreso superior */}
      <div className="absolute top-0 left-0 w-full h-1 bg-stone-200">
        <motion.div 
          className="h-full bg-stone-400"
          initial={{ width: "100%" }}
          animate={{ width: `${(seconds / 300) * 100}%` }}
        />
      </div>

      <header className="mt-10">
        <h1 className="text-2xl tracking-[0.4em] uppercase opacity-40">Athair</h1>
      </header>

      <main className="flex flex-col items-center justify-center flex-1 w-full">
        <AnimatePresence mode="wait">
          {!isActive && !isFinished ? (
            // Pantalla de Inicio / Menú
            <motion.div exit={{ opacity: 0 }} className="text-center">
              <p className="mb-10 text-stone-400 italic">"Sincroniza tu ritmo con la naturaleza"</p>
              <button 
                onClick={() => setIsActive(true)}
                className="px-12 py-4 border border-stone-200 rounded-full bg-white/50 backdrop-blur-sm shadow-sm active:scale-95 transition-all uppercase tracking-widest text-sm"
              >
                Comenzar (5 min)
              </button>
            </motion.div>
          ) : isActive ? (
            // Pantalla de Ejercicio (El Orbe)
            <div className="relative flex items-center justify-center">
              <motion.div
                animate={{ 
                  scale: phase === 'inhale' ? 1.5 : 0.8,
                  opacity: phase === 'inhale' ? 0.4 : 0.2
                }}
                transition={{ duration: 5.5, ease: "easeInOut" }}
                className="w-64 h-64 bg-white rounded-full blur-3xl shadow-[0_0_100px_rgba(255,255,255,0.8)]"
              />
              <motion.p 
                key={phase}
                initial={{ opacity: 0, y: 10 }}
                animate={{ opacity: 1, y: 0 }}
                className="absolute text-lg tracking-[0.5em] uppercase text-stone-400"
              >
                {phase === 'inhale' ? 'Inhala' : 'Exhala'}
              </motion.p>
            </div>
          ) : (
            // Pantalla Final
            <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} className="text-center">
              <p className="text-2xl italic font-serif text-stone-400">Nos vemos pronto.</p>
            </motion.div>
          )}
        </AnimatePresence>
      </main>

      <footer className="mb-10 opacity-30 text-[10px] tracking-widest uppercase">
        Inspirado en James Nestor
      </footer>
    </motion.div>
  );
};

export default AthairApp;